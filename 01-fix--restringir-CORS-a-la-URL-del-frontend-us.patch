diff --git a/.env.example b/.env.example
index 4cfac04..37ec39b 100644
--- a/.env.example
+++ b/.env.example
@@ -28,4 +28,7 @@ SMTP_USER=
 SMTP_PASSWORD=
 
 # Frontend
+# URL exacta del frontend (esquema + dominio, sin barra final ni ruta).
+# Ej.: http://localhost:5173 o https://mi-app.vercel.app
+# Es el único origen que acepta el CORS y se usa en el enlace de recuperación de contraseña.
 FRONTEND_URL=
diff --git a/core/server.ts b/core/server.ts
index e3f88b3..c1724f3 100644
--- a/core/server.ts
+++ b/core/server.ts
@@ -32,7 +32,19 @@ export class Server {
     }
 
     middleware() {
-        this.app.use(cors());
+        const frontendUrl = process.env.FRONTEND_URL?.trim().replace(/\/+$/, '');
+
+        if (!frontendUrl) {
+            throw new Error('Falta la variable FRONTEND_URL para configurar el CORS');
+        }
+
+        this.app.use(cors({
+            // Solo se permite el origen del frontend. Las peticiones sin
+            // cabecera Origin (curl, Postman, servidor a servidor) no pasan por CORS.
+            origin: (origin, callback) => {
+                callback(null, !origin || origin === frontendUrl);
+            }
+        }));
         this.app.use(express.json());
     }
 
